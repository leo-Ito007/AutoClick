{
  "manifest_version": 3,
  "name": "Auto Clicker Ultra Nativo",
  "version": "2.1",
  "description": "Auto clicker indetectável usando API Debugger",
  "permissions": [
    "debugger",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}